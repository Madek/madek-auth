{:paths [:cljc-paths :resource-paths]
 :deps
 {better-cond/better-cond {:mvn/version "2.1.5"}
  buddy/buddy-sign {:mvn/version "3.6.1-359"}
  cheshire/cheshire {:mvn/version "6.2.0"} ; transitive dep of several others; pinned to align transitive com.fasterxml.jackson.*/* versions
  clj-commons/clj-yaml {:mvn/version "1.0.29"}
  clj-pid/clj-pid {:mvn/version "0.1.2"}
  cljs-http/cljs-http {:mvn/version "0.1.49"}
  com.fasterxml.jackson.core/jackson-databind {:mvn/version "2.21.5"} ; transitive dep of several others; multiple GHSA
  com.github.seancorfield/honeysql {:mvn/version "2.7.1437"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
  com.lucasbradstreet/cljs-uuid-utils {:mvn/version "1.0.2"}
  com.taoensso/timbre {:mvn/version "6.8.0"}
  com.zaxxer/HikariCP {:mvn/version "5.0.1"}
  digest/digest {:mvn/version "1.4.10"}
  environ/environ {:mvn/version "1.2.0"}
  funcool/cuerdas {:mvn/version "2026.415"}
  hiccup/hiccup {:mvn/version "1.0.5"}
  http-kit/http-kit {:mvn/version "2.8.1"}
  lambdaisland/uri {:mvn/version "1.19.155"}
  logbug/logbug {:mvn/version "5.0.0"}
  metosin/reitit {:mvn/version "0.10.1"}
  noencore/noencore {:mvn/version "0.4.0"} ; (transitive dep of cljs-http; enforce new version to avoid :redef warnings)
  nrepl/nrepl {:mvn/version "1.7.0"}
  org.bouncycastle/bcpkix-jdk18on {:mvn/version "1.85"} ; transitive dep of buddy/buddy-sign; fix several CVEs
  org.clojure/clojure {:mvn/version "1.12.5"}
  org.clojure/core.memoize {:mvn/version "1.2.281"}
  org.clojure/tools.cli {:mvn/version "1.4.256"}
  org.postgresql/postgresql {:mvn/version "42.7.13"}
  reagent/reagent {:mvn/version "1.2.0"}
  ring-middleware-accept/ring-middleware-accept {:mvn/version "2.0.3"}
  ring/ring-json {:mvn/version "0.5.1"}
  spootnik/signal {:mvn/version "0.2.5"}
  tick/tick {:mvn/version "0.6.2"}}
 :aliases
 {:cljc-paths ["cljc-src"]
  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "3.4.12"}}}
  :resource-paths ["resources"]
  :outdated {:extra-deps {com.github.liquidz/antq {:mvn/version "2.11.1276"}}
             :main-opts ["-m" "antq.core"]}

  :cljfmt {:extra-deps {io.github.weavejester/cljfmt
                        {:git/tag "0.16.5"
                         :sha "609d5706793fa494f6d76563be3318f7526f894f"}}
           :main-opts ["-m" "cljfmt.main"]}

  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
          :ns-default scripts.build}}}
